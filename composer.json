{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "refactor-circus/cortex",
    "description": "AI Orchestration",
    "keywords": [
        "laravel",
        "refactor-circus",
        "cortex"
    ],
    "homepage": "https://github.com/refactor-circus/cortex",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Fletcher",
            "email": "5743488+jayjfletcher@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "refactor-circus/keystone": "dev-main",
        "laravel/ai": "^1.2",
        "laravel/framework": "^13.35",
        "laravel/mcp": "^1.0.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.4",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "phpstan/extension-installer": "^1.4.3",
        "refactor-circus/atrium": "dev-main",
        "refactor-circus/keen": "dev-main",
        "refactor-circus/pennantplus": "dev-main",
        "refactor-circus/ringside": "dev-main",
        "refactor-circus/standards": "dev-main"
    },
    "suggest": {
        "refactor-circus/atrium": "Show the Cortex dashboard and its redirect-domain tab and section on other packages' screens (v0.1.0 or later, which carries the screen-extensions registry).",
        "refactor-circus/pennantplus": "Switch Cortex in Atrium on and off with the CortexSupportFeature Pennant feature (dev-main)."
    },
    "conflict": {
        "refactor-circus/atrium": "<0.1.0"
    },
    "autoload": {
        "psr-4": {
            "RefactorCircus\\Cortex\\": "src/"
        },
        "files": [
            "src/Domains/ConcreteServer/shims.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RefactorCircus\\Cortex\\Tests\\": "tests/",
            "RefactorCircus\\Cortex\\Database\\Factories\\": "database/factories/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:create-sqlite-db --ansi",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test:without-atrium": [
            "vendor/bin/pest --configuration=phpunit.without-atrium.xml"
        ],
        "test": [
            "@composer dump-autoload",
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit",
            "@test:without-atrium"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ],
        "local:install": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer install"
        ],
        "local:update": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer update"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "RefactorCircus\\Cortex\\CortexServiceProvider"
            ],
            "aliases": {
                "Cortex": "RefactorCircus\\Cortex\\Facades\\Cortex"
            }
        },
        "atrium": {
            "plugins": [
                "RefactorCircus\\Cortex\\Atrium\\CortexPlugin"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "refactor-circus/ringside": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Keystone.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Atrium.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/PennantPlus.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Keen.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Ringside.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Standards.git"
        }
    ]
}
